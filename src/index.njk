---
layout: base.njk
permalink: /
---
{%- set h = home.hero -%}
<section class="hero dark">
  <div class="hero-bg" aria-hidden="true">{% for u in h.backgrounds %}<div class="hero-slide{% if loop.first %} on{% endif %}" style="background-image:url('{{ u.image or u }}')"></div>{% endfor %}</div>
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">{% for part in h.eyebrow.split(" · ") %}{% if not loop.first %}<span class="sep" aria-hidden="true"></span> {% endif %}{{ part }}{% endfor %}</p>
      <h1>{{ h.headline_start | escape | replace(" / ", "<br>") | safe }} {% if h.headline_gold %}<em>{{ h.headline_gold }}</em> {% endif %}{{ h.headline_end }}</h1>
      <p class="lede">{{ h.text }}</p>
      <div class="hero-ctas">{% set buttons = h.buttons %}{% set dark = true %}{% include "partials/buttons.njk" %}</div>
    </div>
    <figure class="hero-art" style="margin:0">
      {% if h.image %}
      <img class="hero-photo" src="{{ h.image }}" alt="{{ h.caption_left }}">
      {% else %}
      {% include "partials/hero-build.njk" %}
      {% endif %}
      <figcaption><span>{{ h.caption_left }}</span><span>{{ h.caption_right }}</span></figcaption>
    </figure>
  </div>
</section>

{% if home.audiences.show %}
<nav class="audiences dark" aria-label="Who we work with">
  <div class="wrap aud-grid" style="padding:0">
    {% for a in home.audiences.items %}
    <a class="aud" href="{{ a.link }}"><span class="k">{{ a.label }}</span><h3>{{ a.title }}</h3><p>{{ a.text }}</p></a>
    {% endfor %}
  </div>
</nav>
{% endif %}

{% if home.build.show %}
<section id="build">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{{ home.build.eyebrow }}</p>
      <h2>{{ home.build.heading }}</h2>
      <p>{{ home.build.text }}</p>
    </div>
    <div class="svc-grid">
      {% for s in home.build.items %}
      <div class="svc">
        {% set icon = s.icon %}{% include "partials/icon.njk" %}
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if home.projects.show %}
<section id="projects" class="projects">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{{ home.projects.eyebrow }}</p>
      <h2>{{ home.projects.heading }}</h2>
      <p>{{ home.projects.text }}</p>
    </div>
    <div class="proj-grid">
      {% for proj in collections.projects | limit(home.projects.how_many) %}
        {% include "partials/project-card.njk" %}
      {% endfor %}
    </div>
    {% if collections.projects.length > home.projects.how_many and home.projects.button_label %}
    <p class="see-all"><a class="btn btn-outline" href="/projects/">{{ home.projects.button_label }}</a></p>
    {% endif %}
  </div>
</section>
{% endif %}

{% if home.process.show %}
<section id="process">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{{ home.process.eyebrow }}</p>
      <h2>{{ home.process.heading }}</h2>
      <p>{{ home.process.text }}</p>
    </div>
    <div class="steps">
      {% for s in home.process.steps %}
      <div class="step"><span class="n">{{ s.title }}</span><p>{{ s.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if home.partners.show %}
<section id="partners" class="partners dark">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{{ home.partners.eyebrow }}</p>
      <h2>{{ home.partners.heading }}</h2>
      <p style="color:#cfd3d8">{{ home.partners.text }}</p>
    </div>
    <div class="partner-grid">
      {% for pn in home.partners.panels %}
      {% include "partials/panel.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if home.contact.show %}
<section id="contact">
  <div class="wrap contact-grid">
    <div class="contact-card">
      <div class="section-head" style="margin-bottom:8px">
        <p class="eyebrow">{{ home.contact.eyebrow }}</p>
        <h2>{{ home.contact.heading }}</h2>
        <p>{{ home.contact.text }}</p>
      </div>
      {% include "partials/contact-lines.njk" %}
    </div>
    {% include "partials/form.njk" %}
  </div>
</section>
{% endif %}
