{#- Gold line drawing used when a project has no photo. Pass `kind`. -#}
{% if kind == "stacked" %}
<svg viewBox="0 0 400 220" aria-hidden="true"><g fill="none" stroke="#c9a961" stroke-width="1.5">
  <line x1="10" y1="210" x2="390" y2="210"/>
  <path d="M130 90 L200 40 L270 90"/>
  <rect x="140" y="83" width="120" height="127"/><line x1="140" y1="140" x2="260" y2="140"/><line x1="140" y1="180" x2="260" y2="180" stroke-dasharray="4 3"/>
  <rect x="156" y="98" width="34" height="28"/><rect x="210" y="98" width="34" height="28"/>
  <rect x="156" y="150" width="22" height="30" stroke="#d1aa58" fill="#d1aa58" fill-opacity=".14"/><rect x="200" y="152" width="44" height="22"/>
  <rect x="156" y="188" width="26" height="14"/><rect x="214" y="188" width="30" height="14"/>
  <text x="276" y="196" fill="#d1aa58" stroke="none" font-family="Montserrat, Arial, sans-serif" font-size="11">1BR UNIT</text>
</g></svg>
{% elif kind == "duplex" %}
<svg viewBox="0 0 400 220" aria-hidden="true"><g fill="none" stroke="#c9a961" stroke-width="1.5">
  <line x1="10" y1="210" x2="390" y2="210"/>
  <rect x="100" y="60" width="200" height="150"/><line x1="200" y1="60" x2="200" y2="210" stroke-width="2"/>
  <rect x="92" y="52" width="216" height="8"/><line x1="100" y1="135" x2="300" y2="135"/>
  <rect x="118" y="76" width="64" height="40"/><rect x="218" y="76" width="64" height="40"/>
  <rect x="118" y="150" width="22" height="44" stroke="#d1aa58" fill="#d1aa58" fill-opacity=".14"/><rect x="150" y="152" width="34" height="28"/>
  <rect x="260" y="150" width="22" height="44" stroke="#d1aa58" fill="#d1aa58" fill-opacity=".14"/><rect x="216" y="152" width="34" height="28"/>
  <g stroke="#d1aa58" stroke-dasharray="2 4" opacity=".7"><line x1="80" y1="40" x2="80" y2="210"/><line x1="320" y1="40" x2="320" y2="210"/><line x1="80" y1="40" x2="320" y2="40"/></g>
</g></svg>
{% elif kind == "lots" %}
<svg viewBox="0 0 400 220" aria-hidden="true"><g fill="none" stroke="#c9a961" stroke-width="1.5">
  <path d="M40 30 H360 V200 H40 Z"/>
  <line x1="200" y1="30" x2="200" y2="200" stroke="#d1aa58" stroke-dasharray="6 4"/>
  <rect x="90" y="80" width="64" height="70"/><path d="M90 80 L122 62 L154 80"/>
  <rect x="246" y="80" width="64" height="70"/><path d="M246 80 L278 62 L310 80"/>
  <path d="M40 200 Q120 186 200 200 T360 200" stroke-dasharray="3 4" opacity=".6"/>
  <g fill="#d1aa58" stroke="none" font-family="Montserrat, Arial, sans-serif" font-size="12"><text x="104" y="176">LOT 1</text><text x="260" y="176">LOT 2</text></g>
</g></svg>
{% else %}
<svg viewBox="0 0 400 220" aria-hidden="true"><g fill="none" stroke="#c9a961" stroke-width="1.5">
  <line x1="10" y1="210" x2="390" y2="210"/>
  <rect x="140" y="40" width="120" height="170"/><line x1="140" y1="95" x2="260" y2="95"/><line x1="140" y1="152" x2="260" y2="152"/>
  <rect x="132" y="32" width="136" height="8"/>
  <rect x="154" y="54" width="36" height="28"/><rect x="206" y="54" width="40" height="28"/>
  <rect x="154" y="108" width="24" height="44" stroke="#d1aa58" fill="#d1aa58" fill-opacity=".14"/><rect x="194" y="110" width="52" height="28"/>
  <rect x="154" y="166" width="36" height="24"/><rect x="206" y="166" width="40" height="24"/>
  <polyline points="140,152 124,152 124,162 112,162 112,172"/>
</g></svg>
{% endif %}
